{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:8082",
      "http://localhost:19006"
    ]
  },
  "ConnectionStrings": {
    "Waggo": "Host=localhost;Port=5432;Database=waggo;Username=waggo;Password=change-me-locally"
  },
  "Pricing": {
    "Currency": "COP",
    "CommissionRate": 0.2,
    "RoundingIncrement": 100,
    "Rates": {
      "Individual": {
        "BaseFee": 8000,
        "PerMinute": 250
      },
      "Group": {
        "BaseFee": 5000,
        "PerMinute": 150
      }
    }
  },
  "Encryption": {
    "Key": ""
  },
  "Authentication": {
    "UseDevelopmentUser": false,
    "Jwt": {
      "Authority": "",
      "Audience": "waggo-api",
      "RoleClaimType": "roles"
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  }
}
